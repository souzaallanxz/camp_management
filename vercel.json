{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/sign-in",
      "destination": "/api/auth-simple"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-me"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/auth-simple.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/auth-me.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
} 