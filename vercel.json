{
  "version": 2,
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/server.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 