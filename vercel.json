{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/teams/(.*)",
      "destination": "/api"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/api"
    },
    {
      "source": "/camps/(.*)",
      "destination": "/api"
    },
    {
      "source": "/registrations/(.*)",
      "destination": "/api"
    },
    {
      "source": "/payments/(.*)",
      "destination": "/api"
    },
    {
      "source": "/campers/(.*)",
      "destination": "/api"
    },
    {
      "source": "/users/(.*)",
      "destination": "/api"
    },
    {
      "source": "/settings/(.*)",
      "destination": "/api"
    },
    {
      "source": "/debug/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1536,
      "maxDuration": 30
    }
  }
} 